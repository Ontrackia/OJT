# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ontrackia_ojt

# MongoDB (para evidencias)
MONGODB_URI=mongodb://localhost:27017/ontrackia_evidences

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production
