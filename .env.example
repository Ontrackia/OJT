# ============================================
# ONTRACKIA OJT V2.0 - CONFIGURACIÓN DE ENTORNO
# Protocolo Búnker: Seguridad Forense Máxima
# ============================================

# ==========================================
# BASE DE DATOS POSTGRESQL
# Integridad primaria para tablas de OJT
# ==========================================
DATABASE_URL=postgresql://ontrackia_ojt:CAMBIAR_EN_PRODUCCION_PASSWORD_SEGURO@postgres:5432/ontrackia_ojt_db
POSTGRES_USER=ontrackia_ojt
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_SEGURO
POSTGRES_DB=ontrackia_ojt_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# MONGODB - PERSISTENCIA DE EVIDENCIAS
# Sellado SHA-256 para evidencias forenses
# ==========================================
MONGODB_URI=mongodb://ontrackia_evidences:CAMBIAR_PASSWORD_MONGO@mongodb:27017/ojt_evidences
MONGODB_DATABASE=ojt_evidences
MONGODB_COLLECTION_EVIDENCES=forensic_evidences
MONGODB_USER=ontrackia_evidences
MONGODB_PASSWORD=CAMBIAR_PASSWORD_MONGO

# ==========================================
# JWT - BÚNKER DE AUTENTICACIÓN
# Algoritmo HS256 con rotación obligatoria cada 90 días
# ==========================================
JWT_SECRET_KEY=CAMBIAR_ESTE_SECRET_MINIMO_64_CARACTERES_ALEATORIOS_PRODUCCION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRATION_DAYS=7

# ==========================================
# API MISTRAL - VALIDACIÓN AI SENIOR AUDITOR
# Coach de auditoría basado en ICAO Doc 9859
# ==========================================
MISTRAL_API_KEY=tu_api_key_mistral_aqui
MISTRAL_MODEL=mistral-large-latest
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
MISTRAL_MAX_TOKENS=2048
MISTRAL_TEMPERATURE=0.3

# Validación de Gobernanza AI (4 Pilares)
AI_GOVERNANCE_MIN_DEPTH_SCORE=7
AI_GOVERNANCE_DIRTY_DOZEN_CHECK=true
AI_GOVERNANCE_TRACEABILITY_REQUIRED=true
AI_GOVERNANCE_NO_SUPERFICIALITY=true

# ==========================================
# BRANDING OFICIAL "MORADO OSCURO"
# Paleta de colores certificada
# ==========================================
THEME_PRIMARY_COLOR=#7c3aed
THEME_BACKGROUND_DEEP=#0a051a
THEME_TOUCH_TARGET_MIN=44px
THEME_GLASSMORPHISM_ENABLED=true

# ==========================================
# OFFLINE-FIRST PWA
# IndexedDB (Dexie.js) + SyncEngine
# ==========================================
PWA_ENABLED=true
PWA_SYNC_INTERVAL_MS=30000
PWA_INDEXEDDB_NAME=ontrackia_ojt_local
PWA_INDEXEDDB_VERSION=2

# ==========================================
# API BACKEND
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_LOG_LEVEL=info

# CORS (ajustar en producción)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ==========================================
# FRONTEND VITE
# ==========================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=OnTrackIA OJT V2.0
VITE_ENVIRONMENT=development

# ==========================================
# FORENSIC INTEGRITY
# SHA-256 para sellado de evidencias
# ==========================================
FORENSIC_HASH_ALGORITHM=sha256
FORENSIC_SEAL_REQUIRED=true
FORENSIC_AUDIT_LOG_ENABLED=true

# ==========================================
# STORAGE
# Directorio temporal para evidencias
# ==========================================
UPLOAD_DIR=/app/uploads/evidences
MAX_UPLOAD_SIZE_MB=50

# ==========================================
# REGULATORY COMPLIANCE
# Estándares aeronáuticos
# ==========================================
COMPLIANCE_STANDARD=RAC_LPTA_66
COMPLIANCE_APPENDIX_1_COVERAGE=70
COMPLIANCE_ATA_CHAPTERS_ENABLED=true
COMPLIANCE_FORENSIC_SEAL_MANDATORY=true

# ==========================================
# MONITORING & LOGGING
# ==========================================
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false

# ==========================================
# ZERO INSURRECTIONS PROTOCOL
# Nomenclatura oficial únicamente
# ==========================================
ALLOWED_BRANCH_NAMES=main,stable,verified
FORBIDDEN_TERMS=master,gold,beta,alpha,dev-unstable

# ==========================================
# SEGURIDAD ADICIONAL
# ==========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# ==========================================
# NOTAS DE SEGURIDAD
# ==========================================
# ⚠️ CAMBIAR TODOS LOS PASSWORDS EN PRODUCCIÓN
# ⚠️ JWT_SECRET debe ser generado con: openssl rand -hex 64
# ⚠️ Rotar JWT_SECRET cada 90 días
# ⚠️ MongoDB y PostgreSQL deben usar passwords de 32+ caracteres
# ⚠️ Habilitar SSL/TLS en producción
# ⚠️ Validar CORS_ORIGINS en producción (solo dominios autorizados)
